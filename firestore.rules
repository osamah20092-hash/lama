rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Put YOUR admin email(s) here — must match ADMIN_EMAILS in web/js/firebase-config.js
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['osamah20092@gmail.com'];
    }

    // Signed in, has a profile, and the admin hasn't deactivated it (users/{uid}.disabled).
    function isActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) == false;
    }

    match /users/{uid} {
      // Read your own profile; admin reads everyone.
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Create your own profile once, with the starting balance and non-admin —
      // unless the admin deleted this account (banned/{uid}).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.coins == 1000
        && request.resource.data.isAdmin == false
        && request.resource.data.get('disabled', false) == false
        && !exists(/databases/$(database)/documents/banned/$(uid));

      // Admin can change anything. A normal, active user may change ONLY their own coins
      // (for staking/winning), and never by more than 200 in a single write
      // (anti-abuse cap = MAX_SINGLE_WIN). Name/email/isAdmin/disabled stay frozen for self-writes.
      allow update: if isAdmin()
        || (request.auth != null
            && request.auth.uid == uid
            && resource.data.get('disabled', false) == false
            && request.resource.data.get('disabled', false) == false
            && request.resource.data.name == resource.data.name
            && request.resource.data.email == resource.data.email
            && request.resource.data.isAdmin == resource.data.isAdmin
            && request.resource.data.coins >= 0
            && (request.resource.data.coins - resource.data.coins) <= 200);

      allow delete: if isAdmin();
    }

    // Private sessions (web/js/rooms.js). Signed-in players can list them (the "open sessions"
    // list) — the room doc holds only public table state; cards live in hands/, the PIN in
    // private/. Only the host writes the room; others join (or watch) through members/{uid}
    // and send moves through actions/.
    function roomHost(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data.hostUid;
    }
    function isRoomHost(code) {
      return request.auth != null && roomHost(code) == request.auth.uid;
    }

    match /rooms/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 50;
      allow create: if isActive()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.code == code;
      allow update, delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      // Waiting hall. Members read/write only their own entry; a kicked member stays kicked.
      match /members/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isRoomHost(code));
        allow create: if isActive() && request.auth.uid == uid
          && request.resource.data.kicked == false;
        allow update: if isRoomHost(code)
          || (request.auth != null && request.auth.uid == uid
              && resource.data.kicked == false && request.resource.data.kicked == false);
        allow delete: if request.auth != null && (request.auth.uid == uid || isRoomHost(code));
      }

      // Each player's cards, keyed by uid: nobody else (except the host's engine) can read them.
      match /hands/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isRoomHost(code));
        allow write: if isRoomHost(code);
      }

      // Moves sent to the host. You may only act for the seat you're sitting in.
      match /actions/{id} {
        allow create: if isActive()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.seat is int
          && get(/databases/$(database)/documents/rooms/$(code)).data.seats[request.resource.data.seat].uid == request.auth.uid;
        allow read, delete: if isRoomHost(code);
        allow update: if false;
      }

      // PIN + full engine state (for the host to resume after a refresh). Host only.
      match /private/{doc} {
        allow read, update: if isRoomHost(code);
        allow create: if request.auth != null
          && getAfter(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid;
      }
    }

    // Match history: a player may add their own records and read them back (for their stats);
    // admin reads everything.
    match /matches/{id} {
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }

    // Accounts the admin deleted. Stops the profile from being recreated on the next sign-in;
    // the player may read only their own entry (to be told why).
    match /banned/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }
  }
}
